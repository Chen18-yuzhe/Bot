# Copy to .env for Docker Compose or export the values in your shell.
APP_MODEL_PROVIDER=dashscope
DASHSCOPE_API_KEY=
QWEATHER_API_HOST=
QWEATHER_API_KEY=
ADMIN_API_TOKEN=replace-with-a-long-random-token
BILI_LOGIN_TIMEOUT_SECONDS=180

# Optional real supplier integrations. Leave blank to keep travel checkout disabled.
TRAVEL_SUPPLIER_API_URL=
TRAVEL_SUPPLIER_API_KEY=
TRAVEL_FLIGGY_API_URL=
TRAVEL_FLIGGY_API_KEY=
TRAVEL_RAIL_MCP_ENABLED=false
# Requires Node.js 18+; pinned third-party read-only package launched through npx.
TRAVEL_RAIL_MCP_COMMAND=npx
TRAVEL_RAIL_MCP_PACKAGE=12306-mcp@0.3.9
TRAVEL_RAIL_MCP_TIMEOUT_SECONDS=45
